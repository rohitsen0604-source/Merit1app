<?xml version="1.0" encoding="utf-8"?>
<!--
    LOWER SC OS3 overlay section. Shown as a REAL bounded TYPE_APPLICATION_OVERLAY
    window pinned to the bottom of the screen while the underlying app stays
    visible and usable everywhere around it.

    Contains the existing capture/action controls exactly as approved:
      - BURST / CAPTURE / AUTO / FACE row
      - MINIMIZE (left) / EXIT (right)
      (AUTO interval is configured in Settings, not here)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:clickable="false">

    <!-- ============ BOTTOM CONTROL ROW: BURST / CAPTURE / AUTO / FACE (connected horizontal strip) ============ -->
    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:background="@drawable/segmented_panel"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btnBurst"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_burst"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnCapture"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:background="@drawable/segmented_cell_capture"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_capture"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnAuto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_auto"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnFace"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_face"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ============ Very bottom row: MINIMIZE (left) / EXIT (right) ============ -->
    <Button
        android:id="@+id/btnMinimize"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="96dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_glass_transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_minimize"
        android:textColor="@color/white"
        android:textSize="10sp" />

    <Button
        android:id="@+id/btnExit"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="76dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_glass_transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_exit"
        android:textColor="@color/white"
        android:textSize="10sp" />

</FrameLayout>