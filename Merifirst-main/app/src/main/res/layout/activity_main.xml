<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ============ Floating camera window (preview panel) ============ -->
    <FrameLayout
        android:id="@+id/floatingPanel"
        android:layout_width="240dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/panel_background">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            app:implementationMode="compatible" />

        <!-- Compact translucent header / drag handle -->
        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="top"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/drag_hint"
            android:textColor="#99FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Zoom readout (tappable: toggles wide/1.0x), floats over the preview -->
        <TextView
            android:id="@+id/zoomText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_chip"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="1.0x"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- ============ LEFT CONTROL GROUP: BLACK / SWITCH (connected vertical panel) ============ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:background="@drawable/segmented_panel"
        android:orientation="vertical"
        android:padding="1dp">

        <Button
            android:id="@+id/btnBlack"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="74dp"
            android:layout_height="40dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_black"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnSwitch"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="74dp"
            android:layout_height="40dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_switch"
            android:textColor="@color/white"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ============ Window size slider (LEFT edge, between buttons and preview) ============ -->
    <FrameLayout
        android:id="@+id/sizeSliderContainer"
        android:layout_width="40dp"
        android:layout_height="190dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="94dp"
        android:background="@drawable/slider_background">

        <SeekBar
            android:id="@+id/sizeSeekBar"
            android:layout_width="190dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="22"
            android:progressDrawable="@drawable/size_track"
            android:rotation="-90"
            android:thumb="@drawable/zoom_thumb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="1dp"
            android:background="@drawable/status_chip"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="@string/slider_size"
            android:textColor="@color/white"
            android:textSize="8sp" />
    </FrameLayout>

    <!-- ============ Zoom slider (RIGHT edge, between preview and buttons) ============ -->
    <FrameLayout
        android:id="@+id/zoomSliderContainer"
        android:layout_width="40dp"
        android:layout_height="190dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="94dp"
        android:background="@drawable/slider_background">

        <SeekBar
            android:id="@+id/zoomSeekBar"
            android:layout_width="190dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:enabled="false"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/zoom_track"
            android:rotation="-90"
            android:thumb="@drawable/zoom_thumb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="1dp"
            android:background="@drawable/status_chip"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="@string/slider_zoom"
            android:textColor="@color/white"
            android:textSize="8sp" />
    </FrameLayout>

    <!-- ============ RIGHT CONTROL GROUP: SETTING / HELP (connected vertical panel) ============ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/segmented_panel"
        android:orientation="vertical"
        android:padding="1dp">

        <Button
            android:id="@+id/btnSetting"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="74dp"
            android:layout_height="40dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_setting"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnHelp"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="74dp"
            android:layout_height="40dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_help"
            android:textColor="@color/white"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ============ Status chip (top center) ============ -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/status_chip"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="@string/status_ready"
        android:textColor="@color/white"
        android:textSize="10sp" />

    <!-- ============ BOTTOM CONTROL ROW: BURST / CAPTURE / AUTO / FACE (connected horizontal strip) ============ -->
    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="52dp"
        android:background="@drawable/segmented_panel"
        android:orientation="horizontal"
        android:padding="1dp">

        <Button
            android:id="@+id/btnBurst"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_burst"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnCapture"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/segmented_cell_capture"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_capture"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnAuto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_auto"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnFace"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/segmented_cell"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_face"
            android:textColor="@color/white"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ============ Interval selector (AUTO interval) ============ -->
    <LinearLayout
        android:id="@+id/intervalRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/status_chip"
        android:orientation="horizontal"
        android:padding="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="3dp"
            android:text="@string/auto_interval_label"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/intervalGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btnInterval4"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnInterval2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/interval_2"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnInterval4"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/interval_4"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnInterval6"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/interval_6"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnInterval10"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/interval_10"
                android:textSize="9sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- ============ Very bottom row: MINIMIZE (left) / EXIT (right) ============ -->
    <Button
        android:id="@+id/btnMinimize"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="96dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_glass_transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_minimize"
        android:textColor="@color/white"
        android:textSize="10sp" />

    <Button
        android:id="@+id/btnExit"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="76dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_glass_transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_exit"
        android:textColor="@color/white"
        android:textSize="10sp" />

    <!-- ============ Permission overlay ============ -->
    <LinearLayout
        android:id="@+id/permissionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/permissionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_required_message"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permission_allow" />
    </LinearLayout>

</FrameLayout>