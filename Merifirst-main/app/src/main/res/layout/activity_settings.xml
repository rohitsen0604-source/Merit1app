<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:letterSpacing="0.02"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!-- Camera settings -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_camera" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_resolution" />

        <Spinner
            android:id="@+id/resolutionSpinner"
            style="@style/SettingsSpinner"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_quality" />

        <Spinner
            android:id="@+id/qualitySpinner"
            style="@style/SettingsSpinner"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_default_camera" />

        <Spinner
            android:id="@+id/lensSpinner"
            style="@style/SettingsSpinner"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ultrawideInfo"
            style="@style/SettingsInfoText"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Capture settings -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_capture" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_auto_interval" />

        <Spinner
            android:id="@+id/intervalSpinner"
            style="@style/SettingsSpinner"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_burst" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_face" />

        <!-- Delivery settings -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_delivery" />

        <LinearLayout
            style="@style/SettingsToggleRow">

            <TextView
                style="@style/SettingsToggleLabel"
                android:text="@string/settings_email_enabled" />

            <android.widget.Switch
                android:id="@+id/emailEnabledSwitch"
                style="@style/SettingsToggle" />
        </LinearLayout>

        <LinearLayout
            style="@style/SettingsToggleRow"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SettingsToggleLabel"
                android:text="@string/settings_gallery_save_enabled" />

            <android.widget.Switch
                android:id="@+id/gallerySaveEnabledSwitch"
                style="@style/SettingsToggle" />
        </LinearLayout>

        <TextView
            style="@style/SettingsMutedText"
            android:layout_marginTop="8dp"
            android:text="@string/settings_delivery_note" />

        <!-- Volume button control (AccessibilityService) -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_volume" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_volume_enable" />

        <TextView
            android:id="@+id/volumeStatusText"
            style="@style/SettingsStatusBox"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_volume_down_hint" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_volume_up_hint"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/volumeOpenSettingsButton"
            style="@style/SettingsSecondaryButton"
            android:layout_marginTop="8dp"
            android:text="@string/settings_volume_open_settings" />

        <!-- Gmail (placeholder, not networked yet) -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_gmail" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_gmail_sender" />

        <EditText
            android:id="@+id/gmailSenderInput"
            style="@style/SettingsInput"
            android:hint="@string/settings_gmail_sender_hint"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_gmail_app_password" />

        <EditText
            android:id="@+id/gmailPasswordInput"
            style="@style/SettingsInput"
            android:hint="@string/settings_gmail_app_password_hint"
            android:inputType="textPassword" />

        <TextView
            style="@style/SettingsFieldLabel"
            android:text="@string/settings_gmail_receiver" />

        <EditText
            android:id="@+id/gmailReceiverInput"
            style="@style/SettingsInput"
            android:hint="@string/settings_gmail_receiver_hint"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/gmailNote"
            style="@style/SettingsMutedText"
            android:layout_marginTop="12dp"
            android:text="@string/settings_gmail_note" />

        <Button
            android:id="@+id/testEmailButton"
            style="@style/SettingsPrimaryButton"
            android:layout_marginTop="20dp"
            android:text="@string/settings_test_email" />

        <Button
            android:id="@+id/clearGmailButton"
            style="@style/SettingsSecondaryButton"
            android:layout_marginTop="10dp"
            android:text="@string/settings_clear_gmail" />

        <!-- Diagnostics -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_diagnostics" />

        <Button
            android:id="@+id/diagnosticsButton"
            style="@style/SettingsSecondaryButton"
            android:text="@string/settings_open_diagnostics" />

        <Button
            android:id="@+id/saveSettingsButton"
            style="@style/SettingsPrimaryButton"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_save" />

    </LinearLayout>

</ScrollView>